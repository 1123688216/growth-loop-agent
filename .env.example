# Optional LLM provider configuration. Never commit real secrets.
# `demo` is safe for local preview. For a real model, inject a managed profile
# with llm_config.ps1 so the provider, endpoint, model, and key stay out of source control.
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Fill these only in a deployment secret store after the official account is approved.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# Local database. Leave empty to use data/growth-loop.sqlite.
SQLITE_DATABASE_PATH=

# Local production preview runs on HTTP, so it needs a non-secure cookie.
# Do not enable this for a public HTTPS deployment.
ALLOW_INSECURE_LOCAL_COOKIE=true

# Optional mature RAG ingestion service. Leave empty to keep the existing
# TypeScript parser/chunker. Set REQUIRED=true only after the service is stable.
RAG_INGESTION_URL=
RAG_INGESTION_REQUIRED=false
RAG_INGESTION_TIMEOUT_MS=960000

# Configure these in services/rag_ingestion when running the Python service.
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_EFFORT=medium
MINERU_TIMEOUT_SECONDS=900
RAG_PARENT_CHUNK_TOKENS=2048
RAG_CHILD_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=20

# GPU service URL consumed by the Python RAG process (start-rag-stack imports it).
# Next.js now sends encoding and vector retrieval requests to RAG_INGESTION_URL.
# Restart both RAG and Next.js after upgrading the adapter; GPU model is unchanged.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8020
# Shared default for document indexing and queries; changing this does not migrate old vectors.
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_TIMEOUT_MS=600000
EMBEDDING_BATCH_SIZE=8

# Configure these on the local embedding service process.
EMBEDDING_BGE_M3_PATH=G:\Embedding\bge-m3
EMBEDDING_QWEN3_PATH=G:\Embedding\qwen3-embedding-0.6b
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_MAX_BATCH_TEXTS=32
EMBEDDING_MAX_TEXT_CHARS=40000

# Optional persistent LangGraph orchestration service. Browser requests still
# go through Next.js; use the same private token in both processes.
WORKFLOW_SERVICE_URL=
WORKFLOW_SERVICE_TOKEN=
WORKFLOW_SERVICE_TIMEOUT_MS=45000
# false keeps the current ungrounded-course compatibility path until V0.4.4
# grounded Tutor wiring is complete; true interrupts when evidence is missing.
WORKFLOW_REQUIRE_SOURCES=false
# With workflow enabled: insufficient local evidence triggers bounded automatic web supplementation.
# Still insufficient after supplementation => wait for sources, never silently generate ungrounded content.
WORKFLOW_AUTO_WEB=true
# advisory：来源验证不足不阻断教学；strict：仍要求证据充分。指定教材范围始终保留。
KNOWLEDGE_GATE_MODE=advisory

# Configure these on the Python workflow process. Leave LLM_ENABLED=false to
# use a deterministic query plan validated by the same Pydantic model.
WORKFLOW_CHECKPOINT_PATH=
WORKFLOW_LLM_ENABLED=false
WORKFLOW_LLM_BASE_URL=
WORKFLOW_LLM_API_KEY=
WORKFLOW_LLM_MODEL=
# Web discovery and Markdown extraction (server-side only).
TAVILY_API_KEY=
# Native DeepSeek search uses the official Responses endpoint; extraction still uses Tavily.
WEB_SEARCH_PROVIDER=tavily
# Server-side search/page proxy only; leave blank for direct internet access.
# Example: http://127.0.0.1:7890 . Local RAG/Embedding/Workflow are unaffected.
WEB_HTTP_PROXY=
# Local public-page extraction needs no Tavily key. Optional: tavily.
WEB_EXTRACT_PROVIDER=local
# 入库前网页用途审核暂默认关闭。收录后仍由 RAG/Evidence Review 判断知识是否够用。
# true 可恢复原审核；此开关不关闭 URL 安全、正文提取或后续教学内容检查。
WEB_PAGE_REVIEW_ENABLED=false
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
# If LLM_BASE_URL is official api.deepseek.com, LLM_API_KEY can be reused instead.
DEEPSEEK_API_KEY=
# RAGFlow: existing document retrieval (server-only; explicit account/document binding required)
RAGFLOW_BASE_URL=http://127.0.0.1:8088
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_MS=60000
